{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Node Attach",
      "skipFiles": ["<node_internals>/**"],
      "port": 8229
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Chrome Attach",
      "port": 9222,
      "urlFilter": "http://coda-local.fit.nasa.gov:3000/*",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
