{
  "name": "coda",
  "version": "2.0.1",
  "description": "Collaborative Operations Data Activation",
  "main": "server/index.ts",
  "scripts": {
    "build": "next build",
    "dev": "cross-env NODE_EXTRA_CA_CERTS=./.env.local.cert.pem NODE_OPTIONS='--inspect' next dev -p 3000",
    "local": "cross-env NODE_ENV=local npm run dev -p 3000",
    "export": "next export",
    "start": "cross-env NODE_ENV=production next start -p 3000",
    "test": "jest",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test",
    "test:coverage": "jest --coverage --reporters=default --reporters=jest-junit",
    "tsc": "tsc --pretty",
    "lint": "eslint . --color --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --color --fix --ext .js,.jsx,.ts,.tsx",
    "postinstall": "rimraf node_modules/paper/dist/docs",
    "docker:dev": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.dev.yml up --build -d",
    "docker:dev:rebuild": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.dev.yml build --no-cache",
    "docker:preview": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.preview.yml up --build -d",
    "docker:preview:rebuild": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.preview.yml build --no-cache"
  },
  "repository": {
    "type": "git",
    "url": "git@eegitlab.fit.jsc.nasa.gov:coda/coda"
  },
  "author": "benjamin.f.feist@nasa.gov",
  "license": "ISC",
  "dependencies": {
    "@evamss/ntlm": "^2.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-regular-svg-icons": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@reduxjs/toolkit": "^1.9.7",
    "abort-controller": "^3.0.0",
    "cacache": "^18.0.0",
    "fast-xml-parser": "^4.3.2",
    "jest-junit": "^16.0.0",
    "leo-profanity": "^1.7.0",
    "lodash": "^4.17.21",
    "lzutf8": "^0.6.3",
    "mapbox-gl": "^2.15.0",
    "mwbot": "^2.1.3",
    "next": "^13.5.5",
    "next-redux-wrapper": "^8.1.0",
    "node-fetch": "^2.7.0",
    "paper": "^0.12.17",
    "plotly.js": "^2.26.2",
    "react": "^18.2.0",
    "react-cookie": "^6.1.1",
    "react-dom": "^18.2.0",
    "react-lazy-load-image-component": "^1.6.0",
    "react-modal": "^3.16.1",
    "react-redux": "^8.1.3",
    "tle.js": "^4.7.3",
    "tough-cookie-file-store": "^2.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "uuid": "^9.0.1",
    "weeknumber": "^1.2.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^13.5.5",
    "@types/cacache": "^17.0.0",
    "@types/geojson": "^7946.0.11",
    "@types/jest": "^29.5.5",
    "@types/lodash": "^4.14.199",
    "@types/mapbox-gl": "^2.7.16",
    "@types/node": "^20.8.6",
    "@types/node-fetch": "^2.6.6",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.13",
    "@types/react-modal": "^3.16.1",
    "@types/react-redux": "^7.1.27",
    "@types/request": "^2.48.10",
    "@types/tough-cookie-file-store": "^2.0.2",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.51.0",
    "eslint-config-next": "^13.5.5",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1"
  },
  "browser": {
    "services/iss-wiki-server": false
  }
}
