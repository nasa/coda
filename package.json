  "description": "Collaborative Operations Data Activation",
  "main": "server/index.ts",
  "scripts": {
    "build": "next build",
    "dev": "cross-env NODE_EXTRA_CA_CERTS=./.env.local.cert.pem NODE_OPTIONS='--inspect' next dev",
    "local": "cross-env NODE_ENV=local npm run dev",
    "export": "next export",
    "start": "cross-env NODE_ENV=production next start",
    "test": "jest",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test",
    "tsc": "tsc --pretty",
    "lint": "eslint . --color --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --color --fix --ext .js,.jsx,.ts,.tsx",
    "postinstall": "sh scripts/postinstall"
  },
  "repository": {
