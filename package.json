{
  "name": "coda",
  "version": "3.0.0",
  "description": "Collaborative Operations Data Activation",
  "main": "src/index.tsx",
  "scripts": {
    "build": "vite build --emptyOutDir && npm run api:build",
    "dev": "concurrently -n vite,api \"npm run vite:dev\" \"npm run api:dev\"",
    "test": "jest",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test",
    "test:coverage": "jest --coverage --reporters=default --reporters=jest-junit",
    "tsc": "tsc --pretty",
    "lint": "eslint . --color --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --color --fix --ext .js,.jsx,.ts,.tsx",
    "postinstall": "rimraf node_modules/paper/dist/docs",
    "docker:preview": "bash ./appcompose.sh preview up -d",
    "docker:preview:rebuild": "bash ./appcompose.sh preview up --build -d",
    "docker:preview:rebuild:nocache": "bash ./appcompose.sh preview build --no-cache",
    "vite:build": "vite build --emptyOutDir",
    "vite:dev": "vite",
    "vite:dev:debug": "vite dev --debug",
    "api:build": "rimraf ./.local/express/dist && esbuild --sourcemap ./src/server/express/server.ts --bundle --format=cjs --platform=node --outfile=./.local/express/dist/api.js",
    "api:build:watch": "npm run api:build -- --watch",
    "api:dev": "concurrently -n build,serve \"npm run api:build:watch\" \"wait-on ./.local/express/dist/api.js && cross-env NODE_EXTRA_CA_CERTS=./.env.local.cert.pem nodemon --enable-source-maps --inspect=8229 --legacy-watch --watch ./.local/express/dist ./.local/express/dist/api.js ./src/server\"",
    "api:prod": "cross-env NODE_ENV=production node ./.local/express/dist/api.js"
  },
  "repository": {
    "type": "git",
    "url": "git@eegitlab.fit.jsc.nasa.gov:coda/coda"
  },
  "author": "jsc-dl-emss-coda@mail.nasa.gov",
  "license": "ISC",
  "dependencies": {
    "@evamss/ntlm": "^2.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@reduxjs/toolkit": "^2.1.0",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "abort-controller": "^3.0.0",
    "cacache": "^18.0.2",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.1",
    "esbuild": "^0.20.0",
    "express": "^4.18.2",
    "fast-xml-parser": "^4.3.3",
    "jest-junit": "^16.0.0",
    "leo-profanity": "^1.7.0",
    "lodash": "^4.17.21",
    "lzutf8": "^0.6.3",
    "mapbox-gl": "^3.1.2",
    "mwbot": "^2.1.3",
    "node-fetch": "^2.7.0",
    "paper": "^0.12.17",
    "path": "^0.12.7",
    "plotly.js": "^2.28.0",
    "react": "^18.2.0",
    "react-cookie": "^7.0.1",
    "react-dom": "^18.2.0",
    "react-lazy-load-image-component": "^1.6.0",
    "react-modal": "^3.16.1",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.0",
    "rimraf": "^5.0.5",
    "stream-browserify": "^3.0.0",
    "tle.js": "^4.9.0",
    "tough-cookie-file-store": "^2.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "uuid": "^9.0.1",
    "vite": "^5.0.12"
  },
  "devDependencies": {
    "@types/cacache": "^17.0.2",
    "@types/express": "^4.17.21",
    "@types/geojson": "^7946.0.13",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.14.202",
    "@types/mapbox-gl": "^2.7.19",
    "@types/node": "^20.11.7",
    "@types/node-fetch": "^2.6.11",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.18",
    "@types/react-modal": "^3.16.3",
    "@types/react-redux": "^7.1.33",
    "@types/request": "^2.48.12",
    "@types/tough-cookie-file-store": "^2.0.4",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.2",
    "vite-plugin-progress": "^0.0.7",
    "vite-tsconfig-paths": "^4.3.1",
    "wait-on": "^7.2.0"
  },
  "browser": {
    "services/iss-wiki-server": false
  }
}
