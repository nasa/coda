{
  "name": "coda",
  "version": "2.0.1",
  "description": "Collaborative Operations Data Activation",
  "main": "server/index.ts",
  "scripts": {
    "build": "next build",
    "dev": "cross-env NODE_EXTRA_CA_CERTS=./.env.local.cert.pem NODE_OPTIONS='--inspect' next dev -p 3000",
    "local": "cross-env NODE_ENV=local npm run dev -p 3000",
    "export": "next export",
    "start": "cross-env NODE_ENV=production next start -p 3000",
    "test": "jest",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test",
    "test:coverage": "jest --coverage --reporters=default --reporters=jest-junit",
    "tsc": "tsc --pretty",
    "lint": "eslint . --color --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --color --fix --ext .js,.jsx,.ts,.tsx",
    "postinstall": "rimraf node_modules/paper/dist/docs",
    "docker:dev": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.dev.yml up --build -d",
    "docker:dev:rebuild": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.dev.yml build --no-cache",
    "docker:preview": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.preview.yml up --build -d",
    "docker:preview:rebuild": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.preview.yml build --no-cache"
  },
  "repository": {
    "type": "git",
    "url": "git@gitlab.fit.jsc.nasa.gov:coda/coda"
  },
  "author": "benjamin.f.feist@nasa.gov",
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.1.1",
    "@fortawesome/free-regular-svg-icons": "^6.1.1",
    "@fortawesome/free-solid-svg-icons": "^6.1.1",
    "@fortawesome/react-fontawesome": "^0.1.18",
    "@reduxjs/toolkit": "^1.8.0",
    "abort-controller": "^3.0.0",
    "agentkeepalive": "^4.2.1",
    "cacache": "^16.0.3",
    "gpxparser": "^3.0.8",
    "@evamss/ntlm": "^2.0.0",
    "leo-profanity": "^1.5.0",
    "lodash": "^4.17.21",
    "lzutf8": "^0.6.1",
    "mapbox-gl": "^2.7.1",
    "mwbot": "^2.0.0",
    "next": "^12.3.2",
    "next-redux-wrapper": "^7.0.5",
    "node-fetch": "^2.6.7",
    "paper": "^0.12.15",
    "plotly.js": "^2.14.0",
    "react": "^17.0.2",
    "react-cookie": "^4.1.1",
    "react-dom": "^17.0.2",
    "react-lazy-load-image-component": "^1.5.1",
    "react-modal": "^3.14.4",
    "react-redux": "^7.2.8",
    "tle.js": "^4.7.0",
    "tough-cookie-file-store": "^2.0.3",
    "typescript": "^4.6.2",
    "uuid": "^8.3.2",
    "weeknumber": "^1.2.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^12.1.0",
    "@types/cacache": "^15.0.1",
    "@types/geojson": "^7946.0.8",
    "@types/jest": "^27.4.1",
    "@types/lodash": "^4.14.180",
    "@types/mapbox-gl": "^2.6.3",
    "@types/node": "^17.0.23",
    "@types/node-fetch": "^2.6.1",
    "@types/react": "^17.0.42",
    "@types/react-dom": "^17.0.14",
    "@types/react-modal": "^3.13.1",
    "@types/react-redux": "^7.1.23",
    "@types/request": "^2.48.8",
    "@types/tough-cookie-file-store": "^2.0.1",
    "@typescript-eslint/eslint-plugin": "^5.16.0",
    "@typescript-eslint/parser": "^5.16.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.11.0",
    "eslint-plugin-react": "^7.29.4",
    "jest": "^27.5.1",
    "jest-junit": "^13.0.0",
    "prettier": "^2.6.0",
    "rimraf": "^3.0.2",
    "ts-jest": "^27.1.3"
  },
  "browser": {
    "services/iss-wiki-server": false
  }
}
