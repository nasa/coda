{
  "name": "coda",
  "version": "3.0.1",
  "description": "Collaborative Operations Data Activation",
  "main": "src/index.tsx",
  "scripts": {
    "build": "npm run vite:build && npm run api:build",
    "dev": "concurrently -n vite,api \"npm run vite:dev:wait\" \"npm run api:dev\"",
    "test": "jest",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test",
    "test:coverage": "jest --coverage --reporters=default --reporters=jest-junit",
    "tsc": "tsc --pretty",
    "lint": "eslint . --color --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --color --fix --ext .js,.jsx,.ts,.tsx",
    "postinstall": "rimraf node_modules/paper/dist/docs",
    "docker:preview": "bash ./appcompose preview up -d",
    "docker:preview:rebuild": "bash ./appcompose preview up --build -d",
    "docker:preview:rebuild:nocache": "bash ./appcompose preview build --no-cache",
    "docker:services": "bash ./appcompose services up -d database",
    "docker:services:rebuild": "bash ./appcompose services build database",
    "docker:services:rebuild:nocache": "bash ./appcompose services build --no-cache database",
    "vite:build": "vite build --emptyOutDir",
    "vite:dev": "vite",
    "vite:dev:debug": "vite dev --debug",
    "vite:dev:wait": "wait-on http://localhost:3001/api/v1/health && vite",
    "api:build": "node esbuild.mjs",
    "api:build:watch": "npm run api:build -- --watch",
    "api:dev": "rimraf ./.local/express/dist && concurrently -n build,serve \"npm run api:build:watch\" \"wait-on ./.local/express/dist/api.js && cross-env NODE_EXTRA_CA_CERTS=./.env.local.cert.pem nodemon --enable-source-maps --inspect=8229 --legacy-watch --watch ./.local/express/dist ./.local/express/dist/api.js ./src/server\"",
    "api:prod": "cross-env NODE_ENV=production node ./.local/express/dist/api.js",
    "migrate:up": "npx mikro-orm migration:up",
    "migrate:down": "npx mikro-orm migration:down",
    "migrate:create": "npx mikro-orm migration:create",
    "migrate:fresh": "npx mikro-orm migration:fresh"
  },
  "repository": {
    "type": "git",
    "url": "git@eegitlab.fit.jsc.nasa.gov:coda/coda"
  },
  "author": "jsc-dl-emss-coda@mail.nasa.gov",
  "license": "ISC",
  "dependencies": {
    "@emss/oauth2-proxy-backend": "^0.2.2",
    "@emss/oauth2-proxy-frontend": "^0.2.3",
    "@evamss/ntlm": "^2.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-regular-svg-icons": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mikro-orm/cli": "6.2.9",
    "@mikro-orm/core": "6.2.9",
    "@mikro-orm/migrations": "6.2.9",
    "@mikro-orm/postgresql": "6.2.9",
    "@mikro-orm/seeder": "6.2.9",
    "@reduxjs/toolkit": "^2.2.6",
    "cacache": "^18.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.4.0",
    "leo-profanity": "^1.7.0",
    "lodash": "^4.17.21",
    "lzutf8": "^0.6.3",
    "mapbox-gl": "^3.5.1",
    "mwbot": "^2.1.3",
    "paper": "^0.12.17",
    "path": "^0.12.7",
    "plotly.js": "^2.33.0",
    "react": "^18.3.1",
    "react-cookie": "^7.1.4",
    "react-dom": "^18.3.1",
    "react-lazy-load-image-component": "^1.6.2",
    "react-modal": "^3.16.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.24.1",
    "rimraf": "^6.0.1",
    "stream-browserify": "^3.0.0",
    "tle.js": "^4.9.0",
    "tough-cookie-file-store": "^2.0.3",
    "undici": "^6.19.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@types/cacache": "^17.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geojson": "^7946.0.14",
    "@types/jest": "^29.5.12",
    "@types/leo-profanity": "^1.5.4",
    "@types/lodash": "^4.17.6",
    "@types/mapbox-gl": "^3.1.0",
    "@types/node": "^20.14.10",
    "@types/plotly.js": "^2.33.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-lazy-load-image-component": "^1.6.4",
    "@types/react-modal": "^3.16.3",
    "@types/react-redux": "^7.1.33",
    "@types/react-test-renderer": "^18.3.0",
    "@types/request": "^2.48.12",
    "@types/tough-cookie-file-store": "^2.0.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.23.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.3",
    "jest": "^29.7.0",
    "jest-css-modules": "^2.1.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "browser": {
    "services/iss-wiki-server": false
  },
  "mikro-orm": {
    "useTsNode": true,
    "tsConfigPath": "./tsconfig.orm.json",
    "configPaths": [
      "mikro-orm.config.ts"
    ]
  }
}
