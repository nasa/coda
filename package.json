{
  "name": "coda",
  "version": "3.3.0",
  "description": "Contextual Operations Data Activation",
  "type": "module",
  "main": "src/index.tsx",
  "scripts": {
    "bom": "docker run -it -v .:/repo -w /repo --name node-sbom --rm eegitlabregistry.fit.nasa.gov/emss/docker-images/node-ci:sbom /make-sbom.sh",
    "make-dotenv": "make-dotenv",
    "build": "npm run vite:build && npm run api:build",
    "dev": "concurrently -n vite,api \"npm run vite:dev:wait\" \"npm run api:dev\"",
    "test": "vitest run --config vitest.config.mts",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test",
    "test:coverage": "vitest run --coverage --config vitest.config.mts",
    "tsc": "tsc --pretty",
    "lint": "concurrently -n js,css \"npm run lint:js\" \"npm run lint:css\"",
    "lint:fix": "concurrently -n js,css \"npm run lint:js:fix\" \"npm run lint:css:fix\"",
    "lint:js": "eslint . --color",
    "lint:js:fix": "eslint . --fix --color",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "postinstall": "rimraf node_modules/paper/dist/paperjs/docs && rimraf node_modules/paper/dist/docs",
    "docker:preview": "bash ./appcompose preview up -d",
    "docker:preview:rebuild": "bash ./appcompose preview build",
    "docker:preview:rebuild:nocache": "bash ./appcompose preview build --no-cache",
    "docker:services": "bash ./appcompose services up -d",
    "docker:services:rebuild": "bash ./appcompose services build",
    "docker:services:rebuild:nocache": "bash ./appcompose services build --no-cache",
    "vite:build": "vite build --emptyOutDir",
    "vite:dev": "vite",
    "vite:dev:debug": "vite dev --debug",
    "vite:dev:wait": "wait-on http://localhost:3001/api/v1/health && vite",
    "api:build": "node esbuild.mjs",
    "api:build:watch": "npm run api:build -- --watch",
    "api:dev": "rimraf ./.local/express/dist && cross-env NODE_ENV=development  npm run api:build:watch",
    "api:prod": "cross-env NODE_ENV=production node ./.local/express/dist/api.js",
    "migration:up": "npx tsx node_modules/@mikro-orm/cli/cli.js migration:up",
    "migration:down": "npx tsx node_modules/@mikro-orm/cli/cli.js migration:down",
    "migration:create": "npx tsx node_modules/@mikro-orm/cli/cli.js migration:create && npx prettier --write ./src/server/database/migrations/Migration20*.ts --ignore-path .prettierignore",
    "migration:fresh": "npx tsx node_modules/@mikro-orm/cli/cli.js migration:fresh"
  },
  "repository": {
    "type": "git",
    "url": "git@eegitlab.fit.jsc.nasa.gov:coda/coda"
  },
  "author": "jsc-dl-emss-coda@mail.nasa.gov",
  "license": "ISC",
  "dependencies": {
    "@mikro-orm/cli": "7.1.4",
    "@mikro-orm/core": "7.1.4",
    "@mikro-orm/migrations": "7.1.4",
    "@mikro-orm/postgresql": "7.1.4",
    "@mikro-orm/seeder": "7.1.4",
    "@vitejs/plugin-react": "6.0.2",
    "dotenv": "17.4.2",
    "globals": "17.6.0"
  },
  "devDependencies": {
    "@emss/logger": "0.12.0",
    "@emss/make-dotenv": "0.5.0",
    "@emss/oauth2-proxy-backend": "0.8.0",
    "@emss/oauth2-proxy-frontend": "0.4.0",
    "@emss/utils": "0.7.0",
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@fortawesome/fontawesome-svg-core": "7.2.0",
    "@fortawesome/free-regular-svg-icons": "7.2.0",
    "@fortawesome/free-solid-svg-icons": "7.2.0",
    "@fortawesome/react-fontawesome": "3.3.1",
    "@reduxjs/toolkit": "2.12.0",
    "@types/aria-query": "5.0.4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/geojson": "7946.0.16",
    "@types/leo-profanity": "1.5.5",
    "@types/lodash": "4.17.24",
    "@types/mapbox-gl": "3.5.0",
    "@types/node": "24.12.4",
    "@types/plotly.js-basic-dist": "1.54.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-modal": "3.16.3",
    "@types/react-redux": "7.1.34",
    "@types/react-test-renderer": "19.1.0",
    "@types/request": "2.48.13",
    "@types/tough-cookie-file-store": "2.0.4",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "@vitest/coverage-v8": "4.1.8",
    "axios-ntlm": "1.4.6",
    "concurrently": "10.0.3",
    "cors": "2.8.6",
    "cross-env": "10.1.0",
    "dayjs": "1.11.21",
    "dockview-react": "6.6.1",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-css-modules": "2.12.0",
    "eslint-plugin-package-json": "0.91.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "express": "5.2.1",
    "fast-xml-parser": "5.8.0",
    "hls.js": "1.6.16",
    "leo-profanity": "1.9.0",
    "lodash": "4.18.1",
    "lzutf8": "0.6.3",
    "mapbox-gl": "3.24.0",
    "maplibre-gl": "5.24.0",
    "nodemon": "3.1.14",
    "paper": "0.12.18",
    "path": "0.12.7",
    "plotly.js-basic-dist": "3.6.0",
    "pmtiles": "4.4.1",
    "prettier": "3.8.3",
    "react": "19.2.7",
    "react-cookie": "8.1.2",
    "react-dom": "19.2.7",
    "react-modal": "3.16.3",
    "react-redux": "9.3.0",
    "react-router": "7.17.0",
    "react-tooltip": "6.0.7",
    "rimraf": "6.1.3",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "stream-browserify": "3.0.0",
    "stylelint": "17.13.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard": "40.0.0",
    "tle.js": "5.0.2",
    "typescript": "6.0.3",
    "undici": "8.4.1",
    "uuid": "14.0.0",
    "vite": "8.0.16",
    "vitest": "4.1.8",
    "wait-on": "9.0.10"
  },
  "browser": {
    "services/iss-wiki-server": false
  },
  "mikro-orm": {
    "preferTs": true,
    "tsConfigPath": "./src/server/database/tsconfig.orm.json",
    "configPaths": [
      "./src/server/database/mikro-orm.config.ts"
    ]
  }
}
