{
  "name": "coda",
  "version": "3.1.0",
  "description": "Contextual Operations Data Activation",
  "type": "module",
  "main": "src/index.tsx",
  "scripts": {
    "bom": "docker run -it -v .:/repo -w /repo --name node-sbom --rm eegitlabregistry.fit.nasa.gov/emss/docker-images/node-ci:sbom /make-sbom.sh",
    "make-dotenv": "make-dotenv",
    "build": "npm run vite:build && npm run api:build",
    "dev": "concurrently -n vite,api \"npm run vite:dev:wait\" \"npm run api:dev\"",
    "test": "vitest run --config vitest.config.mts",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test",
    "test:coverage": "vitest run --coverage --config vitest.config.mts",
    "tsc": "tsc --pretty",
    "lint": "eslint . --color",
    "lint:fix": "eslint . --color --fix",
    "postinstall": "rimraf node_modules/paper/dist/docs",
    "docker:preview": "bash ./appcompose preview up -d",
    "docker:preview:rebuild": "bash ./appcompose preview build",
    "docker:preview:rebuild:nocache": "bash ./appcompose preview build --no-cache",
    "docker:services": "bash ./appcompose services up -d",
    "docker:services:rebuild": "bash ./appcompose services build",
    "docker:services:rebuild:nocache": "bash ./appcompose services build --no-cache",
    "vite:build": "vite build --emptyOutDir",
    "vite:dev": "vite",
    "vite:dev:debug": "vite dev --debug",
    "vite:dev:wait": "wait-on http://localhost:3001/api/v1/health && vite",
    "api:build": "node esbuild.mjs",
    "api:build:watch": "npm run api:build -- --watch",
    "api:dev": "rimraf ./.local/express/dist && cross-env NODE_ENV=development  npm run api:build:watch",
    "api:prod": "cross-env NODE_ENV=production node ./.local/express/dist/api.js",
    "migration:up": "npx tsx node_modules/@mikro-orm/cli/esm.js migration:up",
    "migration:down": "npx tsx node_modules/@mikro-orm/cli/esm.js migration:down",
    "migration:create": "npx tsx node_modules/@mikro-orm/cli/esm.js migration:create && npx prettier --write ./src/server/database/migrations/Migration20*.ts --ignore-path .prettierignore",
    "migration:fresh": "npx tsx node_modules/@mikro-orm/cli/esm.js migration:fresh"
  },
  "repository": {
    "type": "git",
    "url": "git@eegitlab.fit.jsc.nasa.gov:coda/coda"
  },
  "author": "jsc-dl-emss-coda@mail.nasa.gov",
  "license": "ISC",
  "dependencies": {
    "@mikro-orm/cli": "6.6.0",
    "@mikro-orm/core": "6.6.0",
    "@mikro-orm/migrations": "6.6.0",
    "@mikro-orm/postgresql": "6.6.0",
    "@mikro-orm/seeder": "6.6.0",
    "@vitejs/plugin-react-swc": "4.2.2",
    "dotenv": "17.2.3",
    "globals": "16.5.0",
    "ts-node": "10.9.2"
  },
  "devDependencies": {
    "@emss/logger": "0.7.1",
    "@emss/make-dotenv": "0.3.3",
    "@emss/oauth2-proxy-backend": "0.5.0",
    "@emss/oauth2-proxy-frontend": "0.2.9",
    "@emss/utils": "0.5.0",
    "@fortawesome/fontawesome-svg-core": "7.1.0",
    "@fortawesome/free-regular-svg-icons": "7.1.0",
    "@fortawesome/free-solid-svg-icons": "7.1.0",
    "@fortawesome/react-fontawesome": "3.1.0",
    "@reduxjs/toolkit": "2.10.1",
    "@types/aria-query": "^5.0.4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/geojson": "7946.0.16",
    "@types/leo-profanity": "1.5.4",
    "@types/lodash": "4.17.20",
    "@types/mapbox-gl": "3.4.1",
    "@types/node": "24.10.1",
    "@types/plotly.js-basic-dist": "1.54.4",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@types/react-lazy-load-image-component": "1.6.5",
    "@types/react-modal": "3.16.3",
    "@types/react-redux": "7.1.34",
    "@types/react-test-renderer": "19.1.0",
    "@types/request": "2.48.13",
    "@types/tough-cookie-file-store": "2.0.4",
    "@types/uuid": "11.0.0",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "@vitest/coverage-v8": "^4.0.16",
    "axios-ntlm": "1.4.6",
    "concurrently": "9.2.1",
    "cors": "2.8.5",
    "cross-env": "10.1.0",
    "dayjs": "1.11.19",
    "esbuild": "0.27.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-package-json": "0.84.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "express": "5.1.0",
    "fast-xml-parser": "5.3.2",
    "hls.js": "1.6.14",
    "leo-profanity": "1.8.0",
    "lodash": "4.17.21",
    "lzutf8": "0.6.3",
    "mapbox-gl": "3.16.0",
    "maplibre-gl": "5.13.0",
    "nodemon": "3.1.11",
    "paper": "0.12.18",
    "path": "0.12.7",
    "plotly.js-basic-dist": "3.3.0",
    "pmtiles": "4.3.0",
    "prettier": "3.6.2",
    "react": "19.2.0",
    "react-cookie": "8.0.1",
    "react-dom": "19.2.0",
    "react-lazy-load-image-component": "1.6.3",
    "react-modal": "3.16.3",
    "react-redux": "9.2.0",
    "react-router": "7.9.6",
    "react-tooltip": "5.30.0",
    "rimraf": "6.1.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "stream-browserify": "3.0.0",
    "tle.js": "5.0.1",
    "typescript": "5.9.3",
    "undici": "7.16.0",
    "uuid": "13.0.0",
    "vite": "7.2.2",
    "vitest": "^4.0.16",
    "wait-on": "9.0.3"
  },
  "browser": {
    "services/iss-wiki-server": false
  },
  "mikro-orm": {
    "useTsNode": true,
    "tsConfigPath": "./src/server/database/tsconfig.orm.json",
    "configPaths": [
      "./src/server/database/mikro-orm.config.ts"
    ]
  }
}
