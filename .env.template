# CODA local-development environment for public/open-source contributors.
# Copy this file to `.env`. NASA-only integrations use inert placeholders and
# are unavailable unless valid credentials and network access are supplied.

# Local services and storage
DOCKER_HOST_SSL_CERTS_DIR="./.local/certs"
DOCKER_HOST_SSL_PRIVATE_DIR="./.local/private"
DOCKER_DB_DATA_DIR="./.local/database"
DOCKER_DB_INIT_DIR="./.local/db-init"
REDIS_CACHE_DIR="./.local/redis"
DOCKER_IMAGE_DATABASE="postgres:17.7-alpine3.22"
DB_HOST="localhost"
DB_NAME="coda"
DB_PORT="5431"
DB_USER="postgres"
DB_PASS="coda-local-dev"

# Container values (application images are not used by docker:services:public)
IMAGE_VERSION="dev"
REGISTRY_IMAGE="not-used-locally"

# Local authentication bypass
MOCK_USER="true"
OAUTH2_PROXY_COOKIE_SECRET="localdevlocaldevlocaldevlocaldev"
OAUTH2_PROXY_OIDC_ISSUER_URL="NA"
OAUTH2_PROXY_LOGIN_URL="NA"
OAUTH2_PROXY_REDEEM_URL="NA"
OAUTH2_PROXY_OIDC_JWKS_URL="NA"
OAUTH2_PROXY_WHITELIST_DOMAIN="NA"
OAUTH2_PROXY_CLIENT_ID="NA"
OAUTH2_PROXY_CLIENT_SECRET="NA"
OAUTH2_PROXY_REDIRECT_URL="NA"

# Public mode prevents automatic requests to NASA-only data services.
OFFLINE_MODE="true"
VITE_PUBLIC_OFFLINE_MODE="true"
HOST="http://localhost:3000"
EPHEMERIS_SYNC_FROM_URL=""
EMSS_TOKEN="not-used-locally"
IO_KEY="not-used-locally"
WIKI_USER="not-used-locally"
WIKI_PASSWORD="not-used-locally"
TOPO_USER="not-used-locally"
TOPO_PASSWORD="not-used-locally"
SPACETRACK_USERNAME="not-used-locally"
SPACETRACK_PASSWORD="not-used-locally"

# Map and video integrations
VITE_PUBLIC_MAPBOX_KEY=""
VITE_PUBLIC_MAPLIBRE_BASE_URL=""
VITE_PUBLIC_MAPLIBRE_PMTILES_FILENAME=""
VITE_PUBLIC_LIVE_STREAMS_ENABLED="false"
VITE_PUBLIC_TALKYBOT_URL=""
VITE_PUBLIC_MEDIA_MTX_CONTROL_URL="http://127.0.0.1:9997/"
VITE_PUBLIC_MEDIA_MTX_HLS_URL="http://127.0.0.1:8888/"
VITE_PUBLIC_MEDIA_MTX_RECORDINGS_URL="http://127.0.0.1:9996/"
VITE_PUBLIC_MTX_VIDEO_MAX_AGE_DAYS="7"
HLS_BUFFER_DURATION_SECONDS="900"
MEDIAMTX_USERNAME="not-used-locally"
MEDIAMTX_PASSWORD="not-used-locally"

# Local-only logging
LOG_ENABLE_APP_LOGGING="false"
LOG_DATA_APP_ID="coda"
LOG_DATA_SERVER_NAME="local-dev"
LOG_SERVER_HTTP_ENDPOINT="http://127.0.0.1/disabled"
LOG_INTERNAL_ENDPOINT="udp://127.0.0.1:514"
VITE_PUBLIC_LOG_LEVEL="debug"