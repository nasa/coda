{
  "compilerOptions": {
    "target": "es2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "outDir": "./.local/vite/dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "./src",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true /* Skip type checking all .d.ts files. true is recommended */,
    "lib": ["dom", "esnext"],
    "allowJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "isolatedModules": true,
    "incremental": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "jsxImportSource": "react",
    "typeRoots": ["./node_modules/@types", "./typings", "./node_modules"],
    "types": ["vite/client", "node", "vitest/globals", "react", "react-dom"],
    "preserveConstEnums": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", ".local", "public", "static"]
}
