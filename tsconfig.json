{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "baseUrl": ".",
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "client/*": [
        "client/*"
      ],
      "components/*": [
        "./components/*"
      ],
      "public/*": [
        "./public/*"
      ],
      "store/*": [
        "./store/*"
      ],
      "utils/*": [
        "./utils/*"
      ],
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "next.config.js",
  ],
  "exclude": [
    "node_modules"
  ]
}