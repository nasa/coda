# !!! AUTO-GENERATED AT CONTAINER START — DO NOT EDIT THE RENDERED FILE !!!
#
# Source of truth: docker/nginx/setup-auth-unified.conf.template
# docker-entrypoint.sh runs `envsubst '${AUTH_HOST}' < ...template > setup-auth-unified.conf`
# before nginx starts, so every ${AUTH_HOST} below becomes the value of the
# AUTH_HOST env var (e.g. emss-labs.fit.nasa.gov). nginx's own $variables
# (which use bare-`$var`, not `${var}`) are unaffected.
#
# Unified auth variant of setup-auth.conf.
#
# Points all auth traffic at the shared oauth2-proxy running on ${AUTH_HOST}
# instead of a sidecar oauth2-proxy container on this host.
#
# The SESSION cookie is scoped to .fit.nasa.gov, so a user who already authenticated
# via any other EMSS app on the same domain (e.g. ${AUTH_HOST}) is already
# logged in here without a second LaunchPad redirect.
#
# Baked into docker-compose.yml on this branch — no override file needed.
# route-require-auth.conf is UNCHANGED — it still does `auth_request /oauth2/auth` and
# reads the same $upstream_http_x_auth_request_* variables as before.

# LaunchPad SBX is registered with /api/v1/auth/nasalp/adfs/oidc/login as the only
# allowed redirect URI — but for the shared-proxy flow the callback goes directly to
# ${AUTH_HOST} (which rewrites it to /oauth2/callback internally).
# CODA's nginx does NOT need to handle this path; this location block is intentionally
# absent so stale requests to it return 404 rather than silently mis-routing.

# /oauth2/ — sign-in page and other oauth2-proxy UI, served from the shared proxy.
location /oauth2/ {
    proxy_pass       https://${AUTH_HOST}/unified-auth/oauth2/;
    proxy_ssl_server_name on;
    proxy_set_header Host                    ${AUTH_HOST};
    proxy_set_header X-Real-IP               $remote_addr;
    proxy_set_header X-Scheme                $scheme;
    # $http_host carries the client-sent Host header (coda-local.fit.nasa.gov),
    # not nginx's server_name, so the return URL is correct after the callback.
    proxy_set_header X-Auth-Request-Redirect $scheme://$http_host$request_uri;
}

# /oauth2/auth — subrequest endpoint hit by auth_request in route-require-auth.conf.
# X-Auth-Request-Redirect encodes the original CODA URL into the LaunchPad state
# parameter so oauth2-proxy redirects back here (not ${AUTH_HOST}) after the callback.
location = /oauth2/auth {
    proxy_pass       https://${AUTH_HOST}/unified-auth/oauth2/auth;
    proxy_ssl_server_name on;
    proxy_set_header Host                    ${AUTH_HOST};
    proxy_set_header X-Real-IP               $remote_addr;
    proxy_set_header X-Scheme                $scheme;
    proxy_set_header X-Auth-Request-Redirect $scheme://$http_host$request_uri;
    proxy_set_header Content-Length          "";
    proxy_pass_request_body                  off;
}

# Logout — forward to the shared proxy's sign_out.
location = /logout {
    proxy_pass https://${AUTH_HOST}/unified-auth/oauth2/sign_out;
    proxy_ssl_server_name on;
    proxy_intercept_errors on;
    proxy_set_header Host        ${AUTH_HOST};
    proxy_set_header X-Real-IP   $remote_addr;
    proxy_set_header X-Scheme    $scheme;
    error_page
        301 302 303 304 307 308
        400 401 402 403 404 405 406 408 409 410 411 412 413 414 415 416 421 429
        500 501 502 503 504 505 507
        =200
        /loggedout;
}

location = /login {
    include route-require-auth.conf;
    alias /usr/share/nginx/html/;
    try_files /loggedin.html =404;
}

location = /is-logged-in {
    proxy_pass https://${AUTH_HOST}/unified-auth/oauth2/auth;
    proxy_ssl_server_name on;
    proxy_intercept_errors on;
    error_page
        301 302 303 304 307 308
        400 401 402 403 404 405 406 408 409 410 411 412 413 414 415 416 421 429
        500 501 502 503 504 505 507
        /loggedout;
}

location = /loggedout {
    alias /usr/share/nginx/html/;
    try_files /loggedout.html =404;
}
