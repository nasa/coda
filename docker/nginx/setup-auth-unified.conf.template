# !!! AUTO-GENERATED AT CONTAINER START — DO NOT EDIT THE RENDERED FILE !!!
#
# Source of truth: docker/nginx/setup-auth-unified.conf.template
# docker-entrypoint.sh renders this template before nginx starts. ${AUTH_HOST}
# becomes its environment value; nginx's own $variables (which use bare-`$var`,
# not `${var}`) are unaffected.
#
# Points all auth traffic at the shared oauth2-proxy running on ${AUTH_HOST}
# instead of a sidecar oauth2-proxy container on this host.
#
# The SESSION cookie is scoped to .fit.nasa.gov, so a user who already authenticated
# via any other EMSS app on the same domain (e.g. ${AUTH_HOST}) is already
# logged in here without a second LaunchPad redirect.
#
# /oauth2/ — sign-in page and other oauth2-proxy UI, served from the shared proxy.
location /oauth2/ {
    proxy_pass       https://${AUTH_HOST}/oauth2/;
    proxy_ssl_server_name on;
    proxy_set_header Host                    $proxy_host;
    proxy_set_header X-Real-IP               $remote_addr;
    proxy_set_header X-Scheme                $scheme;
    # $http_host carries the client-sent Host header (coda-local.fit.nasa.gov),
    # not nginx's server_name, so the return URL is correct after the callback.
    proxy_set_header X-Auth-Request-Redirect $scheme://$http_host$request_uri;
}

# /oauth2/auth — subrequest endpoint hit by auth_request in route-require-auth.conf.
# oauth2-proxy's AuthOnly handler (which serves this endpoint) returns a bare 401
# immediately on an unauthenticated request — it does not read X-Auth-Request-Redirect
# or build any redirect itself. The actual return-URL is carried separately: nginx's
# `error_page 401 = @error401` (nginx.conf) turns that 401 into a 302 to
# /oauth2/sign_in?rd=$rd_encoded, so no redirect header is needed on this subrequest.
# (X-Auth-Request-Redirect IS needed below on /oauth2/ for the sign-in/callback flow,
# which is a different oauth2-proxy handler that does consume it.)
location = /oauth2/auth {
    proxy_pass       https://${AUTH_HOST}/oauth2/auth;
    proxy_ssl_server_name on;
    proxy_set_header Host                    $proxy_host;
    proxy_set_header X-Real-IP               $remote_addr;
    proxy_set_header X-Scheme                $scheme;
    proxy_set_header Content-Length          "";
    proxy_pass_request_body                  off;
}

# Logout — forward to the shared proxy's sign_out.
location = /logout {
    proxy_pass https://${AUTH_HOST}/oauth2/sign_out;
    proxy_ssl_server_name on;
    proxy_intercept_errors on;
    proxy_set_header Host        $proxy_host;
    proxy_set_header X-Real-IP   $remote_addr;
    proxy_set_header X-Scheme    $scheme;
    error_page
        301 302 303 304 307 308
        400 401 402 403 404 405 406 408 409 410 411 412 413 414 415 416 421 429
        500 501 502 503 504 505 507
        =200
        /loggedout;
}

location = /login {
    include route-require-auth.conf;
    alias /usr/share/nginx/html/;
    try_files /loggedin.html =404;
}

location = /is-logged-in {
    proxy_pass https://${AUTH_HOST}/oauth2/auth;
    proxy_ssl_server_name on;
    proxy_intercept_errors on;
    proxy_set_header Host        $proxy_host;
    proxy_set_header X-Real-IP   $remote_addr;
    proxy_set_header X-Scheme    $scheme;
    error_page
        301 302 303 304 307 308
        400 401 402 403 404 405 406 408 409 410 411 412 413 414 415 416 421 429
        500 501 502 503 504 505 507
        /loggedout;
}

location = /loggedout {
    alias /usr/share/nginx/html/;
    try_files /loggedout.html =404;
}
