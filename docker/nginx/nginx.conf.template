user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {

    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Runtime base-URL rewriting for subpath deploys (imago previews).
    # The Vite build emits the literal placeholder `/__BASE_URL__` inside
    # every asset reference and inside the injected `__VITE_BASE_URL__`
    # constant. nginx rewrites that placeholder to the empty string (root
    # mounts: prod, int, dev VMs) or to a tenant prefix like
    # `/emss/coda/<branch>` (imago) as it streams the response body.
    # `${BASE_URL_REPLACE}` is supplied by envsubst at container start —
    # see Dockerfile. Applied at http scope so both server blocks (:443 and
    # :8080) inherit it. See docs/imago-runtime-base-url.md.
    sub_filter '/__BASE_URL__' '${BASE_URL_REPLACE}';
    sub_filter_once off;
    # text/css is required: Vite emits `url(/__BASE_URL__/fonts/...)` and
    # `url(/__BASE_URL__/assets/...)` inside built CSS bundles. Without
    # the rewrite those URLs 404, the SPA fallback returns index.html as
    # the response body, and the browser fails to decode HTML as a font.
    sub_filter_types text/html application/javascript application/json text/css;

    # All EMSS Nginx log_format must be this format, to be ingested properly by
    # emss/logs logstash
    log_format main '$remote_addr $http_x_forwarded_for "$remote_user" $email [$time_local] "$host" '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent"';

    access_log  /var/log/nginx/access.log  main;
    sendfile        on;
    keepalive_timeout  65;

    proxy_connect_timeout       28800;
    proxy_send_timeout          28800;
    proxy_read_timeout          28800;
    send_timeout                28800;

    #gzip  on;

    server {

        listen 443 ssl;
        listen [::]:443 ssl;
        server_name  codanginx;

        ssl_certificate      /etc/pki/tls/certs/nginx.crt;
        ssl_certificate_key  /etc/pki/tls/private/nginx.key;
        ssl_session_cache    shared:SSL:1m;
        ssl_session_timeout  5m;
        ssl_ciphers  HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers  on;

        client_max_body_size 50G;

        root /usr/share/nginx/html;

        include setup-auth.conf;

        location / {
            include route-require-auth.conf;
            try_files $uri $uri/ /index.html;  # Rewrite all requests to index.html
        }

        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
            expires max;
            log_not_found off;
        }

        #
        # Serve API container
        #

        # Put the user endpoint behind auth so we can get the user data from the auth system
        location /api/v1/user/current {
            # Enforce launchpad auth
            include route-require-auth.conf;

            proxy_pass http://apiv1:3001/api/v1/user/current;
            proxy_redirect off;
            proxy_buffering off;
        }

        # Protect the emss/dataView and emss/dataRefresh endpoints since they require superuser
        location /api/v1/emss {
            include route-require-auth.conf;

            proxy_pass http://apiv1:3001/api/v1/emss;
            proxy_redirect off;
            proxy_buffering off;
        }

        # Allow ephemeris sync from other CODA instances — auth handled by x-api-key in the app
        location /api/v1/db/ephemeris/recent {
            proxy_pass http://apiv1:3001/api/v1/db/ephemeris/recent;
            proxy_redirect off;
            proxy_buffering off;
        }

        # Protect /api/v1/db endpoints since many require superuser (ephemeris, gps, photos, etc.)
        location /api/v1/db {
            include route-require-auth.conf;

            proxy_pass http://apiv1:3001/api/v1/db;
            proxy_redirect off;
            proxy_buffering off;
        }

        # Protect /api/v1/profiler endpoints since they require superuser
        location /api/v1/profiler {
            include route-require-auth.conf;

            proxy_pass http://apiv1:3001/api/v1/profiler;
            proxy_redirect off;
            proxy_buffering off;
        }

        #
        # Serve API container. Allow all traffic because auth will be handled
        # internally by the API if we ever implement auth in CODA
        #
        location /api/v1/ {
            proxy_pass http://apiv1:3001/api/v1/;
            proxy_redirect off;
            proxy_buffering off;

            # For websockets
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
        }

    }

    # Plain-HTTP listener for imago preview deploys. Per
    # imago/docs/proxy-design.md §5 and §9.1, imago's Traefik edge terminates
    # TLS and runs ForwardAuth against the shared oauth2-proxy BEFORE
    # forwarding here, so this block has no SSL and no `auth_request`. The
    # :443 listener above is unchanged and remains the entry point for the
    # standalone single-app CODA deploy.
    #
    # Auth header contract under imago: Traefik forwards oauth2-proxy's
    # X-Auth-Request-* headers (per proxy-design.md §5.6). The :443 block
    # uses nginx auth_request_set to rename those into the X-User / X-Email
    # / X-Access-Token headers apiv1 expects. On :8080 the headers arrive
    # pre-set from Traefik and we rename them via imago-auth-headers.conf
    # included inside each proxy_pass location (nginx's "array directive"
    # inheritance rule means a location that declares any proxy_set_header
    # loses all server-scope ones, so we repeat the include rather than
    # hoist it).
    server {
        listen 8080;
        listen [::]:8080;
        server_name codanginx;

        client_max_body_size 50G;

        root /usr/share/nginx/html;

        # Static asset + SPA fallback locations, shared with the :443 block.
        include locations-shared.conf;

        location /api/v1/ {
            include imago-auth-headers.conf;
            proxy_pass http://apiv1:3001/api/v1/;
            proxy_redirect off;
            proxy_buffering off;

            # For websockets
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
        }
    }
}
