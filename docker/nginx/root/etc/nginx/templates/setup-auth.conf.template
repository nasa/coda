# Routes authentication requests to the shared oauth2-proxy.

location /oauth2/ {
    proxy_pass       https://${AUTH_HOST}/oauth2/;
    proxy_ssl_server_name on;
    proxy_set_header Host                    ${AUTH_HOST};
    proxy_set_header X-Real-IP               $remote_addr;
    proxy_set_header X-Scheme                $scheme;
    proxy_set_header X-Auth-Request-Redirect $scheme://$http_host$request_uri;
}

location = /oauth2/auth {
    proxy_pass       https://${AUTH_HOST}/oauth2/auth;
    proxy_ssl_server_name on;
    proxy_set_header Host                    ${AUTH_HOST};
    proxy_set_header X-Real-IP               $remote_addr;
    proxy_set_header X-Scheme                $scheme;
    proxy_set_header X-Auth-Request-Redirect $scheme://$http_host$request_uri;
    proxy_set_header Content-Length          "";
    proxy_pass_request_body                  off;
}

location = /logout {
    proxy_pass https://${AUTH_HOST}/oauth2/sign_out;
    proxy_ssl_server_name on;
    proxy_intercept_errors on;
    proxy_set_header Host        ${AUTH_HOST};
    proxy_set_header X-Real-IP   $remote_addr;
    proxy_set_header X-Scheme    $scheme;
    error_page
        301 302 303 304 307 308
        400 401 402 403 404 405 406 408 409 410 411 412 413 414 415 416 421 429
        500 501 502 503 504 505 507
        =200
        /loggedout;
}

location = /login {
    include /etc/nginx/conf.d/route-require-auth.conf;
    alias /usr/share/nginx/html/;
    try_files /loggedin.html =404;
}

location = /is-logged-in {
    proxy_pass https://${AUTH_HOST}/oauth2/auth;
    proxy_ssl_server_name on;
    proxy_intercept_errors on;
    proxy_set_header Host        ${AUTH_HOST};
    proxy_set_header X-Real-IP   $remote_addr;
    proxy_set_header X-Scheme    $scheme;
    error_page
        301 302 303 304 307 308
        400 401 402 403 404 405 406 408 409 410 411 412 413 414 415 416 421 429
        500 501 502 503 504 505 507
        /loggedout;
}

location = /loggedout {
    alias /usr/share/nginx/html/;
    try_files /loggedout.html =404;
}
